# Django configuration
FLASK_ENV=development
SECRET_KEY=replace-with-a-strong-random-secret
PORT=5000
ALLOWED_HOSTS=127.0.0.1,localhost

# Django Channels uses the ASGI server configured in interviewiq/asgi.py

# Local LLM backend: default to Ollama for local models
LLM_BACKEND=ollama
QWEN_ENABLED=true
QWEN_PRIMARY_MODEL=ollama/qwen3:4b
QWEN_FALLBACK_MODEL=ollama/qwen3:4b
QWEN_TIMEOUT_SECONDS=60
QWEN_GPU_LOW_VRAM_MB=1600
QWEN_MAX_NEW_TOKENS=220
QWEN_TEMPERATURE=0.7

# Ollama connection settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=60

# Cloud LLM fallback settings (Gemini first, then Groq)
# Recommended order: Gemini -> Groq
CLOUD_LLM_PROVIDERS=gemini,groq
CLOUD_LLM_PROVIDER=gemini
CLOUD_LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Alternative providers if needed:
# OPENAI_API_KEY=your_openai_key_here
# CLOUD_LLM_PROVIDER=openai
# CLOUD_LLM_MODEL=gpt-4o-mini
# OPENROUTER_API_KEY=your_openrouter_key_here
# CLOUD_LLM_PROVIDER=openrouter
# CLOUD_LLM_MODEL=meta-llama/llama-3.1-8b-instruct
